# Application
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production-use-a-long-random-string

# Database
# SQLite (default, zero-setup for development)
DATABASE_URL=sqlite+aiosqlite:///./textlens.db
# PostgreSQL (production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/textlens

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# NLP Models
SPACY_MODEL=en_core_web_sm
EMBEDDING_MODEL=all-MiniLM-L6-v2

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Processing
ANALYSIS_TIMEOUT_SECONDS=300
MAX_SENTENCES_FOR_EMBEDDING=500
